    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Check if the node returned an error object instead of data\nconst response = $input.item.json;\nconst html = response.data || response.body || \"\"; \nconst statusCode = response.statusCode || (response.error ? 403 : 200);\n\nlet strategy = \"STANDARD\"; \n\n// Catch the Forbidden error explicitly\nif (statusCode === 403 || html.includes(\"cloudflare\") || html.includes(\"challenge-platform\")) {\n  strategy = \"BROWSER_REQUIRED\"; \n} else if (html.length < 500) {\n  strategy = \"JUNK\";\n}\n\nreturn {\n  url: $('Wait').item.json.url || \"unknown\",\n  strategy: strategy,\n  canProceed: strategy !== \"JUNK\"\n};"
      },
