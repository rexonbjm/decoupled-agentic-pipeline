    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Get the current item data\nconst d = $input.item.json;\n\n// --- Layer 1: Structure Check ---\n// Ensure the object actually contains data\nif (!d || Object.keys(d).length === 0) {\n  return {\n    ...d,\n    _isSanityCheckPassed: false,\n    _rejectionReason: \"Empty Object\"\n  };\n}\n\n// --- Layer 2: Required Field Check ---\n// Check if Email and Name exist and aren't placeholders\nconst hasEmail = d.email && d.email.includes('@');\nconst hasName = d.name && d.name.length > 2 && d.name.toLowerCase() !== 'test';\n\n// --- Layer 3: Formatting Check ---\n// Flag common \"junk\" indicators\nconst isJunkEmail = d.email ? (d.email.includes('example.com') || d.email.includes('test.com')) : true;\nconst isGenericName = d.name ? (d.name.toLowerCase().includes('user') || d.name.toLowerCase().includes('admin')) : true;\n\n// --- Final Decision Engine ---\nconst isSanityCheckPassed = hasEmail && hasName && !isJunkEmail && !isGenericName;\n\n// Determine the primary reason for failure (if any)\nlet reason = \"\";\nif (!hasEmail) reason = \"Invalid/Missing Email\";\nelse if (!hasName) reason = \"Invalid/Short Name\";\nelse if (isJunkEmail) reason = \"Junk Domain Found\";\nelse if (isGenericName) reason = \"Generic/Bot Name\";\n\nreturn {\n  ...d, // Keep all your original data\n  _isSanityCheckPassed: isSanityCheckPassed,\n  _rejectionReason: reason\n};"
      },
